# Sur un serveur : copie ce fichier en « .env » et remplis ce que tu as. (Sur GitHub : mets ces mêmes noms dans Settings > Secrets.)
# Aucune de ces clés n'est payante.

# --- Cerveau : écrit les scénarios, regarde les rushs, rédige le bilan (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# secours pour le texte seul (facultatif)
GROQ_API_KEY=

# --- Séquences filmées libres de droits ---
# https://www.pexels.com/api/   (clé immédiate avec un compte Pexels)
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ (la clé s'affiche sur la page quand on est connecté)
PIXABAY_API_KEY=

# --- Publication + statistiques (une seule clé Buffer pour Facebook, Instagram et TikTok) ---
BUFFER_API_KEY=
# hébergement des vidéos sur Cloudinary (seulement si publish.media_host: cloudinary)
CLOUDINARY_URL=

# --- Publication par les API officielles (facultatif, à la place de Buffer) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
IG_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Notification (facultatif) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
