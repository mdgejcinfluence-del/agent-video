# Sur un serveur : copie ce fichier en « .env » et remplis ce que tu as. (Sur GitHub : mets ces mêmes noms dans Settings > Secrets.)
# Aucune de ces clés n'est payante.

# --- Cerveau (au moins une ; NVIDIA en premier) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Publication + statistiques (recommandé : une seule clé Buffer) ---
BUFFER_API_KEY=
# hébergement des vidéos sur Cloudinary (seulement si publish.media_host: cloudinary)
CLOUDINARY_URL=

# --- Publication native (facultatif) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
IG_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Notification (facultatif) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
